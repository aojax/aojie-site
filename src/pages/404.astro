---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · 页面未找到" description="您访问的页面不存在。">
  <div class="container not-found">
    <h1>404</h1>
    <p class="message">这里没有你要找的东西。</p>
    <p class="back"><a href="/">← 回到首页</a></p>
  </div>
</BaseLayout>

<style>
  .not-found {
    margin: 6rem auto;
    text-align: center;
  }

  .not-found h1 {
    font-size: 5rem;
    margin: 0 0 0.3em;
    color: var(--color-text-mute);
    font-family: var(--font-mono);
  }

  .message {
    font-size: 1.1rem;
    color: var(--color-text-soft);
    margin-bottom: 2rem;
  }

  .back {
    color: var(--color-text-mute);
    font-size: 0.9rem;
  }
</style>
