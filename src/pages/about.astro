---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="关于"
  description="林奥杰，研究者。首尔科学综合大学院大学，沉浸式交互动漫文化和旅游部重点实验室。"
>
  <div class="container container--wide about">
    <header class="page-header">
      <h1>关于</h1>
    </header>

    <figure class="portrait">
      <img
        src="/about/lecturing-ecnu.jpg"
        alt="林奥杰在华东师范大学演讲"
        width="360"
        height="360"
        loading="eager"
        decoding="async"
      />
      <figcaption>华东师范大学 · 主题演讲</figcaption>
    </figure>

    <section>
      <h2>我是谁</h2>
      <p>
        <strong>林奥杰</strong>，研究者，主要工作集中在<strong>数字艺术金融、文化数字资产标准化、艺术品鉴证溯源、NFT / 元宇宙数字资产</strong>等交叉领域。
      </p>
      <p>
        现任首尔科学综合大学院大学相关职务，并参与中国艺术经济研究院、沉浸式交互动漫文化和旅游部重点实验室的研究工作。
      </p>
    </section>

    <section>
      <h2>研究方向</h2>
      <ul>
        <li><strong>数字艺术金融</strong> —— NFT、Web3、文化数字资产的价值评估与流通</li>
        <li><strong>艺术品鉴证溯源</strong> —— 区块链 + AI 的证据链工程化</li>
        <li><strong>数字版权资产入表</strong> —— 中国语境下的实务路径与监管</li>
        <li><strong>RWA 与文化出海</strong> —— 跨境合规、链上链下融合</li>
        <li><strong>CSC 艺术人工智能</strong> —— 垂直大模型与文化数据治理</li>
      </ul>
    </section>

    <section>
      <h2>在建项目</h2>
      <ul>
        <li><strong>确源溯源平台</strong> —— 艺术品鉴证溯源 SaaS</li>
        <li><strong>DeepArt 数字藏品估值系统</strong> —— AI 估值模型工程化</li>
        <li><strong>环太湖艺术动产平台</strong> —— 区域文化资产数字化</li>
        <li><strong>苏豪文化出海</strong> —— 文化数字资产跨境</li>
        <li><strong>景德镇国版交</strong> —— 版权交易基础设施</li>
      </ul>
    </section>

    <section>
      <h2>写作与思考</h2>
      <p>
        我长期在 Obsidian 知识库中积累研究材料。本站是研究主线的对外显化，
        主题集中在「确权-评估-流通」三段式结构。
      </p>
      <p>
        所有文章均为研究笔记或阶段思考，引用请注明出处。合作或学术交流可通过以下方式联系。
      </p>
    </section>

    <section>
      <h2>联系方式</h2>
      <ul>
        <li>邮箱：<a href="mailto:olachina@qq.com">olachina@qq.com</a></li>
        <li>RSS：<a href="/rss.xml">订阅本站更新</a></li>
      </ul>
    </section>

    <section class="gallery-section">
      <h2>活动照片</h2>
      <p class="gallery-intro">近年部分学术演讲、论坛交流与教学场景。</p>
      <div class="gallery">
        <figure>
          <img
            src="/photos/portrait-formal-3.jpg"
            alt="林奥杰正装照"
            loading="lazy"
            decoding="async"
          />
          <figcaption>正装照</figcaption>
        </figure>
        <figure>
          <img
            src="/photos/speaking-ecnu-2.jpg"
            alt="华东师范大学演讲 2"
            loading="lazy"
            decoding="async"
          />
          <figcaption>华东师范大学 · 演讲 2</figcaption>
        </figure>
        <figure>
          <img
            src="/photos/speaking-ecnu-2-1.jpg"
            alt="华东师范大学演讲 2-1"
            loading="lazy"
            decoding="async"
          />
          <figcaption>华东师范大学 · 演讲 2-1</figcaption>
        </figure>
        <figure>
          <img
            src="/photos/teaching.jpg"
            alt="授课场景"
            loading="lazy"
            decoding="async"
          />
          <figcaption>授课</figcaption>
        </figure>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about {
    margin: 4rem auto;
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .page-header h1 {
    margin: 0;
  }

  section {
    margin: 3rem 0;
  }

  section h2 {
    font-size: 1.3rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.3em;
  }

  .portrait {
    margin: 0 auto 2.5rem;
    text-align: center;
    max-width: 360px;
  }

  .portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--color-border-soft);
    box-shadow: var(--shadow-soft);
    margin: 0 auto 0.8rem;
    background-color: var(--color-bg-soft);
  }

  .portrait figcaption {
    font-size: 0.85rem;
    color: var(--color-text-mute);
    text-align: center;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  @media (max-width: 640px) {
    .portrait {
      max-width: 240px;
    }
  }

  /* 照片墙 */
  .gallery-section {
    margin: 4rem 0 2rem;
  }

  .gallery-intro {
    color: var(--color-text-soft);
    font-size: 0.95rem;
    margin-top: -0.5em;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
    margin-top: 1.5rem;
  }

  .gallery figure {
    margin: 0;
  }

  .gallery img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-border-soft);
    background-color: var(--color-bg-soft);
    margin: 0;
    transition: transform 0.2s ease;
  }

  .gallery img:hover {
    transform: scale(1.02);
  }

  .gallery figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-mute);
    text-align: center;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  @media (min-width: 900px) {
    .gallery {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 640px) {
    .gallery {
      gap: 0.8rem;
    }
    .gallery img {
      height: 160px;
    }
  }
</style>
