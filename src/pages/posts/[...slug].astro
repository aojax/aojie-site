---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatted = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const updatedFormatted = post.data.updatedDate?.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishDate={post.data.pubDate}
  tags={post.data.tags}
  cover={post.data.cover}
>
  <article class="container post">
    {post.data.cover && (
      <figure class="post-cover">
        <img
          src={post.data.cover}
          alt={post.data.title}
          width="1200"
          height="630"
          loading="eager"
          decoding="async"
        />
      </figure>
    )}

    <header class="post-header">
      {post.data.category && <p class="category">{post.data.category}</p>}
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="description">{post.data.description}</p>}
      <div class="meta">
        <time datetime={post.data.pubDate.toISOString()}>
          发布于 {dateFormatted}
        </time>
        {post.data.updatedDate && (
          <span class="updated"> · 更新于 {updatedFormatted}</span>
        )}
      </div>
      {post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((tag) => <li class="tag">#{tag}</li>)}
        </ul>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <aside class="share" aria-label="分享这篇文章">
      <h3>分享这篇文章</h3>
      <div class="share-grid">
        <div class="share-qr">
          <img
            src={`/qr/${post.id}.png`}
            alt="扫码访问本文"
            width="180"
            height="180"
            loading="lazy"
            decoding="async"
          />
          <p>微信 / 任意扫码 App 即可访问</p>
        </div>
        <div class="share-actions">
          <button
            type="button"
            class="copy-btn"
            data-url={`https://aojie.space/posts/${post.id}/`}
            aria-label="复制文章链接"
          >
            <span class="copy-icon" aria-hidden="true">🔗</span>
            <span class="copy-label">复制链接</span>
          </button>
          <a
            class="share-link"
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(`https://aojie.space/posts/${post.id}/`)}`}
            target="_blank"
            rel="noopener"
          >
            Twitter / X
          </a>
          <a
            class="share-link"
            href={`https://t.me/share/url?url=${encodeURIComponent(`https://aojie.space/posts/${post.id}/`)}&text=${encodeURIComponent(post.data.title)}`}
            target="_blank"
            rel="noopener"
          >
            Telegram
          </a>
          <a
            class="share-link"
            href={`mailto:?subject=${encodeURIComponent(post.data.title)}&body=${encodeURIComponent(`https://aojie.space/posts/${post.id}/`)}`}
          >
            邮件
          </a>
        </div>
      </div>
    </aside>

    <footer class="post-footer">
      <a href="/posts">← 返回所有文章</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    margin: 4rem auto;
  }

  .post-cover {
    margin: 0 0 2.5rem;
  }

  .post-cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-border-soft);
    background-color: var(--color-bg-soft);
    box-shadow: var(--shadow-soft);
    margin: 0;
  }

  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .category {
    font-size: 0.8rem;
    color: var(--color-text-mute);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.8em;
    font-family: var(--font-mono);
  }

  .post-header h1 {
    margin: 0 0 0.4em;
    font-size: 2rem;
    line-height: 1.25;
  }

  .description {
    color: var(--color-text-soft);
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0 0 1rem;
  }

  .meta {
    color: var(--color-text-mute);
    font-size: 0.85rem;
    margin: 0 0 0.8em;
  }

  .updated {
    color: var(--color-text-mute);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    color: var(--color-text-mute);
    font-size: 0.85rem;
  }

  /* 文章正文（Prose 样式） */
  .prose {
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .prose :global(h2) {
    margin-top: 2.5em;
  }

  .prose :global(h3) {
    margin-top: 2em;
  }

  .prose :global(blockquote) {
    margin: 1.8em 0;
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-mute);
  }

  /* 分享区 */
  .share {
    margin: 4rem 0 0;
    padding: 2rem;
    background-color: var(--color-bg-soft);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius);
  }

  .share h3 {
    margin: 0 0 1.5rem;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .share-grid {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .share-qr {
    text-align: center;
  }

  .share-qr img {
    width: 180px;
    height: 180px;
    display: block;
    margin: 0 auto 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: #fff;
  }

  .share-qr p {
    font-size: 0.75rem;
    color: var(--color-text-mute);
    margin: 0;
    line-height: 1.4;
  }

  .share-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .copy-btn,
  .share-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    font-size: 0.9rem;
    color: var(--color-text);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .copy-btn:hover,
  .share-link:hover {
    color: var(--color-link);
    border-color: var(--color-link);
  }

  .copy-btn.is-copied {
    color: #1a7f37;
    border-color: #1a7f37;
  }

  .copy-icon {
    font-size: 0.95em;
  }

  @media (max-width: 640px) {
    .share-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .share-qr img {
      width: 160px;
      height: 160px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url;
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        // fallback
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch { /* noop */ }
        document.body.removeChild(ta);
      }
      const label = btn.querySelector('.copy-label');
      const original = label?.textContent ?? '复制链接';
      if (label) label.textContent = '已复制';
      btn.classList.add('is-copied');
      setTimeout(() => {
        if (label) label.textContent = original;
        btn.classList.remove('is-copied');
      }, 2000);
    });
  });
</script>
