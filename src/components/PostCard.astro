---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, category } = post.data;

const dateFormatted = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  <a href={`/posts/${post.id}`} class="post-card-link">
    {post.data.cover && (
      <div class="cover">
        <img src={post.data.cover} alt={title} loading="lazy" />
      </div>
    )}
    <header class="post-card-header">
      {category && <span class="category">{category}</span>}
      <h2 class="title">{title}</h2>
    </header>
    {description && <p class="description">{description}</p>}
    <footer class="post-card-footer">
      <time datetime={pubDate.toISOString()}>{dateFormatted}</time>
      {tags && tags.length > 0 && (
        <ul class="tags">
          {tags.slice(0, 3).map((tag) => (
            <li class="tag">#{tag}</li>
          ))}
        </ul>
      )}
    </footer>
  </a>
</article>

<style>
  .post-card {
    margin: 2rem 0;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border-soft);
  }

  .cover {
    margin: 0 0 1rem;
    overflow: hidden;
    border-radius: var(--radius);
    background-color: var(--color-bg-soft);
  }

  .cover img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: var(--radius);
    transition: transform 0.3s ease, opacity 0.2s ease;
    opacity: 0.95;
  }

  .post-card-link:hover .cover img {
    transform: scale(1.02);
    opacity: 1;
  }

  .post-card:last-of-type {
    border-bottom: 0;
  }

  .post-card-link {
    display: block;
    color: inherit;
    border-bottom: 0;
  }

  .post-card-link:hover .title {
    color: var(--color-link);
  }

  .post-card-header {
    margin-bottom: 0.6rem;
  }

  .category {
    display: inline-block;
    font-size: 0.75rem;
    color: var(--color-text-mute);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .title {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .description {
    margin: 0.5em 0 0.8em;
    color: var(--color-text-soft);
    line-height: 1.6;
  }

  .post-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--color-text-mute);
  }

  .tags {
    display: flex;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    color: var(--color-text-mute);
  }

  @media (max-width: 640px) {
    .title { font-size: 1.2rem; }
    .post-card-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
</style>
