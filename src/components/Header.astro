---
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: '首页' },
  { href: '/posts', label: '文章' },
  { href: '/about', label: '关于' },
  { href: '/rss.xml', label: 'RSS', external: true },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="site-title">
        <span class="site-title-cn">林奥杰</span>
        <span class="site-title-en">文化数字资产 · AI 赋能 · 历史经典产业</span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        <ul>
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
                {...(item.external ? { 'aria-label': `${item.label} (在新窗口打开)`, target: '_blank', rel: 'noopener' } : {})}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border-soft);
    background-color: var(--color-bg);
    padding: 1.5rem 0;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .site-title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--color-text);
    border-bottom: 0;
    font-weight: 600;
  }

  .site-title:hover {
    color: var(--color-text);
  }

  .site-title-cn {
    font-size: 1.25rem;
    letter-spacing: 0.02em;
  }

  .site-title-en {
    font-size: 0.78rem;
    color: var(--color-text-mute);
    font-family: var(--font-mono);
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .site-nav ul {
    display: flex;
    gap: 1.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    color: var(--color-text-soft);
    font-size: 0.95rem;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--color-text);
    border-bottom-color: var(--color-link);
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .site-nav ul {
      gap: 1.2rem;
    }
  }
</style>
